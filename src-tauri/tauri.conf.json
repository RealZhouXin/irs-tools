{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "irs-tools",
  "version": "0.1.0",
  "identifier": "com.example.irs-tools",
  "build": {
    "beforeBuildCommand": "bun run build && bun run copy-dll",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "检测软件",
        "width": 960,
        "height": 720,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "config/thresholds.json",
      "CommDllv2.dll"
    ]
  }
}
